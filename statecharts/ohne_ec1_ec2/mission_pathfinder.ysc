              <vertices xsi:type="sgraph:State" xmi:id="_eHizJCiKEfGlOJtLHaV4WA" specification="entry /raise Map.check_completion ; raise Status.exploring" name="Explore" incomingTransitions="_eHizHSiKEfGlOJtLHaV4WA _lEaZICk7EfGimP9N0Mhg2w _BgkVEClaEfGimP9N0Mhg2w">
