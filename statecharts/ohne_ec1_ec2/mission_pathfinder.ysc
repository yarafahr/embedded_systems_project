  <sgraph:Statechart xmi:id="_eHiMACiKEfGlOJtLHaV4WA" specification="// Use the event driven execution model.&#xA;// Switch to cycle based behavior&#xA;// by specifying '@CycleBased(200)'.&#xA;@EventDriven&#xA;&#xA;// Use @SuperSteps(yes) to enable&#xA;// super step semantics.&#xA;@SuperSteps(no)&#xD;&#xA;&#xA;interface Status:&#xA;&#x9;out event mission_complete&#xA;&#x9;out event exploring&#xA;&#x9;out event returning&#xA;&#x9;out event in_dead_end&#xA;&#x9;out event battery_low&#xA;&#xA;interface Trigger:&#xA;&#x9;// Define events and variables here. &#xA;&#x9;// Use CTRL + Space for content assist.&#xA;&#x9;in event start&#xA;&#x9;&#xA;interface Map:&#xA;&#x9;out event check_completion&#xA;&#x9;in event completion_checked&#xA;&#x9;var completion_level : integer // percentage&#xA;&#x9;in event reached_pickup_point&#xA;&#x9;&#xA;interface Battery:&#xA;&#x9;out event check_level&#xA;&#x9;in event level_checked&#xA;&#x9;var level : integer // percentage&#xA;&#x9;&#xA;interface WiFi:&#xA;&#x9;out event send_position // Send the current coordinates&#xA;&#x9;&#xA;interface Frontier:&#xA;&#x9;var frontiers : integer // Amount of detected Frontiers&#xA;&#x9;&#xA;interface CmdVel:&#xA;&#x9;var linear_x : real // velocity in m/s" name="mission_pathfinder">
    <regions xmi:id="_eHizFyiKEfGlOJtLHaV4WA" name="main region">
      <vertices xsi:type="sgraph:State" xmi:id="_bJLt0Ck1EfGimP9N0Mhg2w" name="On_Mars" incomingTransitions="_hdGIcCuREfGloomBfBgsFQ">
