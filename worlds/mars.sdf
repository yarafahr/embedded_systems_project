<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="mars">

    <!-- Licht -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <intensity>1</intensity>
      <direction>-1 -1 -1</direction>
      <diffuse>0.8 0.4 0.2 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>10</range>
        <linear>1</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.8 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="station_walls">
      <static>true</static>
      <link name="walls">
        
        <collision name="rm_s"><pose>0 -7.5 0.5 0 0 0</pose><geometry><box><size>5 0.2 1.5</size></box></geometry></collision>
